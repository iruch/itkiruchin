{
  "info": {
    "_postman_id": "4b984fe8-f887-4c89-945d-7465a259e702",
    "name": "ITKAcademy",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "11248330"
  },
  "item": [
    {
      "name": "Create wallet",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"walletId\", pm.response.json().walletId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wallets",
          "host": ["{{baseUrl}}"],
          "path": ["wallets"]
        }
      },
      "response": []
    },
    {
      "name": "Get all wallets",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wallets",
          "host": ["{{baseUrl}}"],
          "path": ["wallets"]
        }
      },
      "response": []
    },
    {
      "name": "Get wallet balance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/wallets/{{walletId}}",
          "host": ["{{baseUrl}}"],
          "path": ["wallets", "{{walletId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Operate - deposit",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"operationType\": \"DEPOSIT\",\n  \"amount\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/wallet",
          "host": ["{{baseUrl}}"],
          "path": ["wallet"]
        }
      },
      "response": []
    },
    {
      "name": "Operate - withdraw",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"walletId\": \"{{walletId}}\",\n  \"operationType\": \"WITHDRAW\",\n  \"amount\": 233\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/wallet",
          "host": ["{{baseUrl}}"],
          "path": ["wallet"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "walletId",
      "value": ""
    }
  ]
}